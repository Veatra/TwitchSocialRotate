{
  "activationMode": {
    "type": "dropdown",
    "label": "Activation Mode",
    "value": "both",
    "options": {
      "both": "Auto Rotate + Chat Command",
      "auto": "Auto Rotate Only",
      "command": "Chat Command Only"
    }
  },
  "previewNext": {
    "type": "button",
    "label": "Preview Next Banner",
    "value": "Preview Next"
  },
  "bannerTheme": {
    "type": "dropdown",
    "label": "Banner / Background Type (all socials)",
    "value": "midnightGlass",
    "options": {
      "midnightGlass": "1. Midnight Glass (Neutral)",
      "cleanFrost": "2. Clean Frost (Light Neutral)",
      "platformPulse": "3. Platform Pulse (Brand Color)",
      "neonEdge": "4. Neon Edge (Brand Accent)",
      "softAurora": "5. Soft Aurora",
      "spectrumRibbon": "6. Spectrum Ribbon",
      "paperCut": "7. Paper Cut",
      "broadcastBar": "8. Broadcast Bar",
      "uploaded": "Use My Uploaded Banner Images"
    }
  },
  "showPlatformLogos": {
    "type": "checkbox",
    "label": "Show Platform Logos",
    "value": true
  },
  "bannerWidth": {
    "type": "slider",
    "label": "Generated Banner Width (px)",
    "value": 760,
    "min": 360,
    "max": 1200,
    "step": 10
  },
  "bannerHeight": {
    "type": "slider",
    "label": "Generated Banner Height (px)",
    "value": 178,
    "min": 110,
    "max": 400,
    "step": 2
  },
  "twitchHandle": {
    "type": "text",
    "label": "Twitch Channel / Handle (blank = hidden)",
    "value": "@yourchannel"
  },
  "discordHandle": {
    "type": "text",
    "label": "Discord Server / Handle (blank = hidden)",
    "value": ""
  },
  "youtubeHandle": {
    "type": "text",
    "label": "YouTube Channel / Handle (blank = hidden)",
    "value": ""
  },
  "twitterHandle": {
    "type": "text",
    "label": "X / Twitter Handle (blank = hidden)",
    "value": ""
  },
  "kickHandle": {
    "type": "text",
    "label": "Kick Channel / Handle (blank = hidden)",
    "value": ""
  },
  "tiktokHandle": {
    "type": "text",
    "label": "TikTok Handle (blank = hidden)",
    "value": ""
  },
  "patreonHandle": {
    "type": "text",
    "label": "Patreon Page / Handle (blank = hidden)",
    "value": ""
  },
  "instagramHandle": {
    "type": "text",
    "label": "Instagram Handle (blank = hidden)",
    "value": ""
  },
  "blueskyHandle": {
    "type": "text",
    "label": "Bluesky Handle (blank = hidden)",
    "value": ""
  },
  "chatCommand": {
    "type": "text",
    "label": "Chat Command to Trigger (leave empty to disable)",
    "value": "!socials"
  },
  "commandPermission": {
    "type": "dropdown",
    "label": "Command Permissions Required",
    "value": "broadcaster+mod",
    "options": {
      "broadcaster": "Broadcaster Only",
      "broadcaster+mod": "Broadcaster + Moderator",
      "broadcaster+mod+vip": "Broadcaster + Mod + VIP",
      "everyone": "Everyone"
    }
  },
  "kickChatroomId": {
    "type": "text",
    "label": "Kick Channel Username or Chatroom ID (leave empty to disable)",
    "value": ""
  },
  "displayDuration": {
    "type": "number",
    "label": "Show Banner Duration (seconds)",
    "value": 5,
    "min": 1,
    "max": 60,
    "step": 1
  },
  "pauseDuration": {
    "type": "number",
    "label": "Pause Before Repeating Cycle (seconds)",
    "value": 60,
    "min": 0,
    "max": 3600,
    "step": 1
  },
  "interBannerGap": {
    "type": "slider",
    "label": "Delay Between Banners (seconds)",
    "value": 0.5,
    "min": 0.0,
    "max": 10.0,
    "step": 0.1
  },
  "animIn": {
    "type": "dropdown",
    "label": "Intro Animation Type",
    "value": "slideInLeft",
    "options": {
      "fadeIn": "1. Fade In",
      "slideInLeft": "2. Slide In Left",
      "slideInRight": "3. Slide In Right",
      "slideInUp": "4. Slide In Up",
      "slideInDown": "5. Slide In Down",
      "bounceIn": "6. Bounce In",
      "zoomIn": "7. Zoom In",
      "flipInX": "8. Flip In X (Horizontal)",
      "flipInY": "9. Flip In Y (Vertical)",
      "blurZoomIn": "10. Blur Zoom In",
      "warpSlideRightIn": "11. Warp Slide Right In",
      "warpSlideLeftIn": "12. Warp Slide Left In",
      "foldIn3D": "13. 3D Fold In"
    }
  },
  "animInDuration": {
    "type": "slider",
    "label": "Intro Animation Speed (seconds)",
    "value": 1.0,
    "min": 0.2,
    "max": 5.0,
    "step": 0.1
  },
  "animOut": {
    "type": "dropdown",
    "label": "Outro Animation Type",
    "value": "slideOutRight",
    "options": {
      "fadeOut": "1. Fade Out",
      "slideOutLeft": "2. Slide Out Left",
      "slideOutRight": "3. Slide Out Right",
      "slideOutUp": "4. Slide Out Up",
      "slideOutDown": "5. Slide Out Down",
      "bounceOut": "6. Bounce Out",
      "zoomOut": "7. Zoom Out",
      "flipOutX": "8. Flip Out X (Horizontal)",
      "flipOutY": "9. Flip Out Y (Vertical)",
      "blurZoomOut": "10. Blur Zoom Out",
      "warpSlideRightOut": "11. Warp Slide Right Out",
      "warpSlideLeftOut": "12. Warp Slide Left Out",
      "foldOut3D": "13. 3D Fold Out"
    }
  },
  "animOutDuration": {
    "type": "slider",
    "label": "Outro Animation Speed (seconds)",
    "value": 1.0,
    "min": 0.2,
    "max": 5.0,
    "step": 0.1
  },
  "enableShadow": {
    "type": "checkbox",
    "label": "Enable Dynamic Graphic Shadows",
    "value": false
  },
  "shadowColor": {
    "type": "colorpicker",
    "label": "Shadow Color",
    "value": "rgba(0, 0, 0, 0.5)"
  },
  "shadowBlur": {
    "type": "slider",
    "label": "Shadow Blur Radius (px)",
    "value": 15,
    "min": 0,
    "max": 50,
    "step": 1
  },
  "shadowOffsetX": {
    "type": "slider",
    "label": "Shadow Shift Horizontal (px)",
    "value": 0,
    "min": -50,
    "max": 50,
    "step": 1
  },
  "shadowOffsetY": {
    "type": "slider",
    "label": "Shadow Shift Vertical (px)",
    "value": 8,
    "min": -50,
    "max": 50,
    "step": 1
  },
  "enableBackingCard": {
    "type": "checkbox",
    "label": "Enable Legibility Backing Panel",
    "value": false
  },
  "backingColor": {
    "type": "colorpicker",
    "label": "Backing Panel Background",
    "value": "rgba(0, 0, 0, 0.4)"
  },
  "backingBorderRadius": {
    "type": "slider",
    "label": "Backing Panel Border Radius (px)",
    "value": 15,
    "min": 0,
    "max": 50,
    "step": 1
  },
  "backingPadding": {
    "type": "slider",
    "label": "Backing Panel Padding (px)",
    "value": 20,
    "min": 0,
    "max": 100,
    "step": 1
  },
  "backingGlowColor": {
    "type": "colorpicker",
    "label": "Backing Glow Color (Ambient Glow)",
    "value": "rgba(0, 0, 0, 0.2)"
  },
  "backingGlowBlur": {
    "type": "slider",
    "label": "Backing Glow Blur Radius (px)",
    "value": 30,
    "min": 0,
    "max": 100,
    "step": 1
  },
  "randomizeOrder": {
    "type": "checkbox",
    "label": "Randomize Banner Order",
    "value": false
  },
  "image1": {
    "type": "image-input",
    "label": "Uploaded Banner 1 — Twitch"
  },
  "image2": {
    "type": "image-input",
    "label": "Uploaded Banner 2 — Discord"
  },
  "image3": {
    "type": "image-input",
    "label": "Uploaded Banner 3 — YouTube"
  },
  "image4": {
    "type": "image-input",
    "label": "Uploaded Banner 4 — X / Twitter"
  },
  "image5": {
    "type": "image-input",
    "label": "Uploaded Banner 5 — Kick"
  },
  "image6": {
    "type": "image-input",
    "label": "Uploaded Banner 6 — TikTok"
  },
  "image7": {
    "type": "image-input",
    "label": "Uploaded Banner 7 — Patreon"
  },
  "image8": {
    "type": "image-input",
    "label": "Uploaded Banner 8 — Instagram"
  },
  "image9": {
    "type": "image-input",
    "label": "Uploaded Banner 9 — Bluesky"
  },
  "image10": {
    "type": "image-input",
    "label": "Uploaded Banner 10 — Custom 10"
  },
  "image11": {
    "type": "image-input",
    "label": "Uploaded Banner 11 — Custom 11"
  },
  "image12": {
    "type": "image-input",
    "label": "Uploaded Banner 12 — Custom 12"
  }
}
